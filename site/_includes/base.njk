<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- set pageDescription = description or site.description %}
    {%- set isNotFoundPage = page.url == "/404.html" %}
    {%- set pageUrl = site.url + page.url %}
    {%- if page.url == "/" %}
    <title>{{ site.title }}</title>
    {%- else %}
    <title>{{ title }} · {{ site.title }}</title>
    {%- endif %}
    <meta name="description" content="{{ pageDescription }}">
    <meta property="og:title" content="{{ title or site.title }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:type" content="{{ 'article' if recipe else 'website' }}">
    {%- if isNotFoundPage %}
    <meta name="robots" content="noindex">
    {%- else %}
    <link rel="canonical" href="{{ pageUrl }}">
    <meta property="og:url" content="{{ pageUrl }}">
    {%- endif %}
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:locale" content="en_US">
    <meta name="twitter:card" content="summary">
    <meta name="generator" content="{{ eleventy.generator }}">
    <script>
      const darkScheme = matchMedia('(prefers-color-scheme: dark)');
      function matchColorScheme() {
        document.documentElement.classList.toggle('wa-dark', darkScheme.matches);
      }
      matchColorScheme();
      darkScheme.addEventListener('change', matchColorScheme);
    </script>
    <link rel="stylesheet" href="https://ka-p.webawesome.com/kit/62ebb3c856194bf8/webawesome@3.15.0/styles/themes/default.css">
    <link rel="stylesheet" href="https://ka-p.webawesome.com/kit/62ebb3c856194bf8/webawesome@3.15.0/styles/utilities.css">
    <link rel="stylesheet" href="https://ka-p.webawesome.com/kit/62ebb3c856194bf8/webawesome@3.15.0/styles/native.css">
    <script type="module" src="https://ka-p.webawesome.com/kit/62ebb3c856194bf8/webawesome@3.15.0/webawesome.loader.js" data-fa-kit-code="d7ec6ed89a"></script>
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/open-fonts/HankenGrotesk.woff2">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/FreeLunch-Regular.woff2">
    <link rel="stylesheet" href="/assets/site.css">
    <meta name="theme-color" content="#fefefc" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1c1a19" media="(prefers-color-scheme: dark)">
    {%- block head %}{% endblock %}
  </head>
  <body>
    {#- One wa-page for every view. `header` fills its header slot; `content` is its main content, the default slot. #}
    <wa-page class="{% block pageClass %}{% endblock %}"{% block pageAttributes %}{% endblock %} mobile-breakpoint="48rem" disable-navigation-toggle>
      {%- block header %}{% endblock %}
      <main{% block mainAttributes %}{% endblock %}>
        {%- block content %}{{ content | safe }}{% endblock %}
      </main>
      {% include "site-footer.njk" %}
    </wa-page>
    {%- block scripts %}{% endblock %}
  </body>
</html>
