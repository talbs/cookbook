<footer slot="footer" class="site-footer wa-stack wa-gap-l">
  <div class="header-rule wa-cluster wa-flex-nowrap wa-gap-0" aria-hidden="true"><span class="rule-run"></span></div>
  <div class="wa-split wa-align-items-baseline wa-gap-m">
    <p class="made-by">Cooked up by <a href="https://github.com/talbs">@talbs</a> <span class="wa-text-nowrap">with
      <wa-random-content class="made-with">
        {%- for food in footerFoods %}
        <a href="{{ food.href }}" id="made-with-{{ loop.index }}"><wa-icon name="{{ food.icon }}" family="duotone" variant="regular" label="{{ food.label }}"></wa-icon></a>
        {%- endfor %}
      </wa-random-content></span>
      {%- for food in footerFoods %}
      <wa-tooltip for="made-with-{{ loop.index }}">{{ food.tooltip }}</wa-tooltip>
      {%- endfor %}
    </p>
    <div class="wa-cluster wa-flex-nowrap wa-align-items-center wa-gap-l">
      <nav class="site-nav wa-cluster wa-gap-l" aria-label="Footer">
        <a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a>
        <a href="{{ site.source }}">Source</a>
      </nav>
      {#- The 404 is one screen tall. #}
      {%- if not isNotFoundPage %}
      <a class="footer-top shortcut wa-border-radius-s" id="footer-top" href="#top"><wa-icon name="arrow-up" variant="regular" label="Back to Top"></wa-icon></a>
      <wa-tooltip for="footer-top" placement="top">Back to Top</wa-tooltip>
      {%- endif %}
    </div>
  </div>
</footer>
