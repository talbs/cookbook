{%- from "pick-popover.njk" import pickPopover -%}
{%- set isHome = page.url == "/" -%}
<div class="site-bar wa-split wa-flex-nowrap wa-align-items-center wa-gap-l">
  {%- if isHome %}
  <wa-button class="special hatch-button" id="site-pick" appearance="plain" hidden><wa-icon slot="start" name="hat-chef" variant="regular"></wa-icon><span class="special-label">Today’s Special!</span></wa-button>
  <wa-tooltip class="special-tip" for="site-pick" placement="bottom">Today’s Special!</wa-tooltip>
  {{ pickPopover("site-pick", "bottom-start") }}
  {%- else %}
  <a class="site-name" href="/">{{ site.title }}</a>
  {%- endif %}
  <div class="wa-cluster wa-flex-nowrap wa-align-items-center wa-gap-2xl">
    {% include "site-nav.njk" %}
    <div class="wa-cluster wa-flex-nowrap wa-align-items-center wa-gap-l">
      <a class="shortcut hatch-button" id="site-search" href="/#search"><wa-icon name="magnifying-glass" variant="regular" label="Search Recipes"></wa-icon></a>
      <wa-tooltip for="site-search" placement="bottom">Search Recipes</wa-tooltip>
      <button class="shortcut hatch-button" id="site-scheme" type="button" aria-label="Switch to dark mode">
        <wa-icon class="to-dark" name="moon" variant="regular"></wa-icon>
        <wa-icon class="to-light" name="sun-bright" variant="regular"></wa-icon>
      </button>
      <wa-tooltip for="site-scheme" placement="bottom">Night Shift</wa-tooltip>
    </div>
  </div>
</div>
