{#- What every listing page shares: site links in wa-page's header slot, then a title, a lede and the dotted rule in its main content.
    A page fills `lede`, `toolbar`, `results` and `scripts` as it needs. #}
{% extends "base.njk" %}

{% block pageClass %}listing-page{% endblock %}

{% block pageAttributes %} disable-sticky="header"{% endblock %}

{% block header %}
  <header slot="header" class="site-header">
    {% include "site-header.njk" %}
  </header>
{% endblock %}

{% block mainAttributes %} id="top" class="listing wa-stack"{% endblock %}

{% block content %}
    {%- set heading = title or site.title %}
    <header class="listing-head wa-split wa-gap-l">
      {%- set titleWords = heading | titleWords %}
      {%- set longestWord = titleWords | longestWordLength %}
      <h1{% if longestWord > 16 %} class="can-break"{% endif %} style="--longest-word: {{ longestWord }}; --title-letters: {{ heading.length }}" aria-label="{{ heading }}"><hue-hop>
        {%- for word in titleWords -%}
        <span class="title-word" aria-hidden="true">{% for letter in word.letters %}<span class="title-letter">{{ letter }}</span>{% endfor %}</span>{% if word.hasSpaceAfter and not loop.last %} {% endif %}
        {%- endfor -%}
      </hue-hop></h1>
      <p class="description wa-text-balance">{% block lede %}{{ lede or description or site.description }}{% endblock %}</p>
    </header>
    <div class="header-rule wa-cluster wa-flex-nowrap wa-gap-0" aria-hidden="true"><span class="rule-run"></span></div>
    {%- block toolbar %}{% endblock %}
    <div class="listing-results wa-stack wa-gap-2xl">
      {% block results %}{% endblock %}
    </div>
{% endblock %}
