{#- The Today’s Special panel: the recipe's icons and title, then when it is for and a way to send it back. listing.js fills it each time it opens. #}
{% macro pickPopover(anchorId, placement) %}
<wa-popover class="pick-popover" for="{{ anchorId }}" placement="{{ placement }}">
  <div class="pick wa-stack wa-gap-m">
    <a class="pick-link wa-stack" href="/"><span class="pick-icons recipe-icons wa-cluster wa-flex-nowrap wa-gap-s" aria-hidden="true"></span><span class="pick-title"></span></a>
    <div class="pick-foot wa-split wa-flex-nowrap wa-align-items-baseline wa-gap-l">
      <p class="pick-label"><span class="wa-text-nowrap"><wa-format-date weekday="long" lang="en"></wa-format-date> <span class="pick-word"></span></span><span class="pick-season wa-text-nowrap"></span></p>
      <button type="button" class="pick-again link-button">Send back</button>
    </div>
    <span class="pick-status wa-visually-hidden" role="status"></span>
  </div>
</wa-popover>
{%- endmacro %}
