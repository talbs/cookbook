---
permalink: /404.html
title: Eighty-Sixed
description: Kitchen talk for “we’re out.” This page is off the menu, or it never made it on.
---
{% extends "listing.njk" %}

{% block pageClass %}listing-page not-found-page{% endblock %}

{% block content %}
<section class="not-found empty-state wa-stack wa-gap-2xl">
  <dl class="stats">
    <div><dt class="wa-visually-hidden">Page not found</dt><dd><span aria-hidden="true">4<wa-random-content class="zero">{% for zero in notFoundZeros %}<wa-icon name="{{ zero.icon }}" family="duotone" variant="regular" canvas="auto"{% if zero.inset %} style="--glyph-inset: {{ zero.inset }}"{% endif %}></wa-icon>{% endfor %}</wa-random-content>4</span><span class="wa-visually-hidden">404</span></dd></div>
  </dl>
  <div class="wa-split wa-align-items-end wa-gap-l">
    <div class="wa-stack wa-gap-xs">
      <h1 class="empty-joke">{{ title }}</h1>
      <p class="empty-detail">{{ description }}</p>
    </div>
    <div class="empty-ways-out wa-cluster wa-align-items-center wa-gap-l">
      <wa-button href="/" appearance="outlined"><wa-icon slot="start" name="arrow-left" variant="regular"></wa-icon>Back to the Recipes</wa-button>
      <a class="not-found-special" href="/" hidden>Today’s Special</a>
    </div>
  </div>
</section>
{% endblock %}

{% block scripts %}
<script type="module" src="/assets/not-found.js"></script>
{% endblock %}
