---
permalink: /tags/
title: Tags
description: Every tag in the cookbook.
lede: Every tag in the cookbook. For when you know you want a casserole but not which one.
---
{% extends "listing.njk" %}

{% block results %}
{%- for group in collections | groupTagsByKind %}
<section class="tag-group wa-stack wa-gap-m" aria-labelledby="{{ group.heading | lower }}-heading">
  <h2 class="section-head" id="{{ group.heading | lower }}-heading">{{ group.heading }}</h2>
  <ul class="listing-rows wa-list-plain" role="list">
    {%- for tag in group.tags %}
    <li><a class="listing-row wa-split wa-flex-nowrap wa-align-items-baseline wa-gap-l" href="{{ tag.url }}"><span class="listing-name"><span class="row-words">{{ tag.name }}</span></span>
      {%- if tag.onlyRecipeTitle %} <span class="listing-detail wa-text-end">{{ tag.onlyRecipeTitle }}</span>
      {%- else %} <span class="listing-detail wa-text-nowrap">{{ tag.count }}<span class="wa-visually-hidden"> recipes</span></span>
      {%- endif -%}
    </a></li>
    {%- endfor %}
  </ul>
</section>
{%- endfor %}
{% endblock %}
