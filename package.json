{
  "name": "cookbook",
  "version": "1.0.0",
  "description": "Personally approved collection of recipes culled from books, shows, and the Internet.",
  "scripts": {
    "build": "rm -rf _site && eleventy",
    "start": "rm -rf _site && node --watch --watch-preserve-output node_modules/@11ty/eleventy/cmd.cjs --serve --quiet",
    "test": "node --test \"test/*.test.js\"",
    "font": "node scripts/make-fonts.js"
  },
  "author": "Brian Talbot",
  "license": "MIT",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@cooklang/cooklang": "0.19.1",
    "subset-font": "2.9.0"
  },
  "engines": {
    "node": ">=24.19"
  }
}
